# Wallet Connect Project ID - Get one at https://cloud.walletconnect.com/
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# NFT Contract Address - Deploy your contract and add the address here
VITE_NFT_CONTRACT_ADDRESS=0x...

# Pinata IPFS (Optional - for production IPFS uploads)
# Get API keys at https://www.pinata.cloud/
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key
