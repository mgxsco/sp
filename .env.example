# Wallet Connect Project ID - Get one at https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# NFT Contract Addresses per chain (PublicMintERC1155)
# Deploy your contract on each chain you want to support
VITE_CONTRACT_MAINNET=
VITE_CONTRACT_SEPOLIA=
VITE_CONTRACT_POLYGON=
VITE_CONTRACT_POLYGON_AMOY=

# Legacy fallback (used if chain-specific address not set)
VITE_NFT_CONTRACT_ADDRESS=

# Pinata IPFS - Get API keys at https://www.pinata.cloud/
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_SECRET_KEY=your_pinata_secret_key
