# ========================================
# Deployment Configuration (Hardhat)
# ========================================

# Deployer wallet private key (DO NOT COMMIT!)
DEPLOYER_PRIVATE_KEY=0x...

# RPC URLs (optional - defaults are provided)
ETH_RPC_URL=https://eth.drpc.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Block explorer API keys (for contract verification)
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ========================================
# Frontend Environment Variables (Vite)
# ========================================

# Wallet Connect Project ID - Get one at https://cloud.walletconnect.com/
VITE_WALLET_CONNECT_PROJECT_ID=

# Pinata IPFS - Get API keys at https://www.pinata.cloud/
VITE_PINATA_API_KEY=
VITE_PINATA_SECRET_KEY=

# ========================================
# Contract Addresses (set after deployment)
# ========================================

# NFT Contract (PublicMintERC1155)
VITE_CONTRACT_MAINNET=
VITE_CONTRACT_SEPOLIA=
VITE_CONTRACT_POLYGON=
VITE_CONTRACT_AMOY=

# Soulbound Contract (SoulboundMintERC1155)
VITE_SOULBOUND_CONTRACT_MAINNET=
VITE_SOULBOUND_CONTRACT_SEPOLIA=
VITE_SOULBOUND_CONTRACT_POLYGON=
VITE_SOULBOUND_CONTRACT_AMOY=

# Seed Contract (SeedERC1155)
VITE_SEED_CONTRACT_MAINNET=
VITE_SEED_CONTRACT_SEPOLIA=
VITE_SEED_CONTRACT_POLYGON=
VITE_SEED_CONTRACT_AMOY=

# Revealed Contract (RevealedERC1155)
VITE_REVEALED_CONTRACT_MAINNET=
VITE_REVEALED_CONTRACT_SEPOLIA=
VITE_REVEALED_CONTRACT_POLYGON=
VITE_REVEALED_CONTRACT_AMOY=
